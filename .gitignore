```gitignore
# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.nox/
*.so

# Build outputs
dist/
build/
*.min.js
*.min.css
target/

# IDE
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.mypy_cache/
.pytest_cache/
.hypothesis/

# Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*

# C/C++
*.o
*.a
*.so
*.dll
*.exe

# Go
*.exe
*.test
*.prof
go.mod
go.sum

# Rust
Cargo.lock

# Gradle
.gradle/
build/

# Zip archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
```