#
# Frontend (Vite)
#
VITE_API_BASE_URL=http://localhost:5174

#
# Backend (Express)
#
DATABASE_URL=postgres://<user>:<password>@localhost:5432/hello_web_db
PORT=5174
TELEGRAM_BOT_TOKEN=<your-bot-token-from-botfather>

#
# Auth / Security
#
# BẮT BUỘC: chuỗi ngẫu nhiên dài để ký cookie phiên đăng nhập.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=<random-long-secret>
# Đặt 'production' trên VPS để bật cookie Secure (chỉ gửi qua HTTPS).
NODE_ENV=development
# Tùy chọn: danh sách origin được phép gọi API (phân tách bằng dấu phẩy).
# Bỏ trống = phản chiếu origin của request (tiện cho dev). Production nên liệt kê rõ.
# ALLOWED_ORIGINS=https://app.tecapro.vn

