#
# Frontend (Vite)
#
VITE_API_BASE_URL=http://localhost:5174

#
# Backend (Express)
#
DATABASE_URL=postgres://<user>:<password>@localhost:5432/hello_web_db
PORT=5174
# Tùy chọn: địa chỉ bind của Express. Mặc định: production=127.0.0.1 (chỉ nginx gọi
# vào được, chống giả X-Forwarded-For), dev=0.0.0.0. Chỉ đặt khi hạ tầng cần khác.
# HOST=127.0.0.1
TELEGRAM_BOT_TOKEN=<your-bot-token-from-botfather>
# Nhắc hạn qua Telegram (việc/công nợ đến hạn). Cần TELEGRAM_BOT_TOKEN.
# Mặc định chạy 08:15 và 13:45 giờ VN, thứ 2 → thứ 6.
# REMINDER_ENABLED=false        # đặt 'false' để tắt bộ nhắc hạn
# REMINDER_TIMES=08:15,13:45    # danh sách giờ VN (HH:MM), phân tách bằng dấu phẩy

#
# Auth / Security
#
# BẮT BUỘC: chuỗi ngẫu nhiên dài để ký cookie phiên đăng nhập.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=<random-long-secret>
# Đặt 'production' trên VPS để bật cookie Secure (chỉ gửi qua HTTPS).
NODE_ENV=development
# Tùy chọn: danh sách origin được phép gọi API (phân tách bằng dấu phẩy).
# Bỏ trống = phản chiếu origin của request (tiện cho dev). Production nên liệt kê rõ.
# ALLOWED_ORIGINS=https://app.tecapro.vn

